<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_appearance">

        <ListPreference
            app:iconSpaceReserved="false"
            app:key="app_theme"
            app:title="@string/pref_theme_title"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:defaultValue="backloggd"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_notifications">

        <ListPreference
            app:iconSpaceReserved="false"
            app:key="notification_interval"
            app:title="@string/pref_notification_interval_title"
            app:summary="@string/pref_notification_interval_summary"
            app:entries="@array/notification_interval_entries"
            app:entryValues="@array/notification_interval_values"
            app:defaultValue="15" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_wishlist">

        <Preference
            app:iconSpaceReserved="false"
            app:key="daily_notification_time"
            app:title="@string/pref_reminder_time_title"
            app:summary="@string/pref_reminder_time_summary"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_about">

        <Preference
            app:iconSpaceReserved="false"
            app:key="developer_link"
            app:title="@string/pref_developer_title"
            app:summary="@string/pref_developer_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="debug_category"
        app:title="@string/pref_category_debug">

        <Preference
            app:iconSpaceReserved="false"
            app:key="debug_run_notification_worker"
            app:title="@string/pref_debug_run_notification_title"
            app:summary="@string/pref_debug_run_notification_summary" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="debug_run_wishlist_worker"
            app:title="@string/pref_debug_run_wishlist_title"
            app:summary="@string/pref_debug_run_wishlist_summary" />

    </PreferenceCategory>

</PreferenceScreen>
