<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="Backloggd Notifications">

        <ListPreference
            app:iconSpaceReserved="false"
            app:key="notification_interval"
            app:title="Notification Interval"
            app:summary="How often to check for new notifications?"
            app:entries="@array/notification_interval_entries"
            app:entryValues="@array/notification_interval_values"
            app:defaultValue="15" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="Wishlist Release Notification">

        <Preference
            app:iconSpaceReserved="false"
            app:key="daily_notification_time"
            app:title="Reminder Time"
            app:summary="Set the time for the daily reminder (default 9:00)"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="About">

        <Preference
            app:iconSpaceReserved="false"
            app:key="developer_link"
            app:title="Developer"
            app:summary="Tysk" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="debug_category"
        app:title="Debug">

        <Preference
            app:iconSpaceReserved="false"
            app:key="debug_run_notification_worker"
            app:title="Run Notification Check Now"
            app:summary="Triggers NotificationCheckWorker as a one-time job" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="debug_run_wishlist_worker"
            app:title="Run Wishlist Check Now"
            app:summary="Triggers WishlistCheckerWorker as a one-time job" />

    </PreferenceCategory>

</PreferenceScreen>