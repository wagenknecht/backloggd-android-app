<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Backloggd" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#16181C</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/back_text</item>
        <item name="colorSecondaryVariant">@color/back_text_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <!-- Apply background to all windows -->
        <item name="android:windowBackground">@color/back_primary</item>

        <item name="materialButtonStyle">@style/Widget.App.Button</item>
    </style>

    <!-- Shown while the app starts; the app theme takes over once MainActivity is ready. -->
    <style name="Theme.Backloggd.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/back_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Backloggd</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/back_pink_dk</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>